{
	"name": "pi-oracle",
	"version": "0.1.4",
	"description": "ChatGPT web-oracle extension for pi with isolated browser auth, async jobs, and project-context archives.",
	"private": false,
	"license": "MIT",
	"author": "Andres Gaibor (https://github.com/AndresGaibor)",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"extension",
		"chatgpt",
		"oracle"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AndresGaibor/pi-oracle.git"
	},
	"bugs": {
		"url": "https://github.com/AndresGaibor/pi-oracle/issues"
	},
	"homepage": "https://github.com/AndresGaibor/pi-oracle#readme",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"extensions",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/oracle/index.ts"
		]
	},
	"scripts": {
		"check:oracle-extension": "tsc --noEmit && esbuild extensions/oracle/index.ts --bundle --platform=node --format=esm --external:@mariozechner/pi-coding-agent --external:@mariozechner/pi-ai --external:@sinclair/typebox --outfile=/tmp/pi-oracle-extension-check.js",
		"sanity:oracle": "tsx scripts/oracle-sanity.ts",
		"pack:check": "npm pack --dry-run",
		"playwright-install": "bunx playwright install",
		"playwright-check": "bun scripts/playwright-check.ts",
		"debug:headed": "bun run scripts/debug-headed.ts",
		"test:cookies": "bun run scripts/test-cookies.ts",
		"watch:cookies": "bun run scripts/watch-cookies.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"dependencies": {
		"@steipete/sweet-cookie": "^0.2.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@types/node": "^25.5.2",
		"@vitest/coverage-v8": "^4.1.2",
		"esbuild": "^0.27.0",
		"playwright": "^1.59.1",
		"tsx": "^4.20.6",
		"typescript": "^5.3.3",
		"vitest": "^4.1.2"
	},
	"engines": {
		"node": ">=20"
	}
}
